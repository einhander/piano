 #include <lsp-plug.in/plug-fw/wrap/ladspa/impl/wrapper.h>
 
+// --- Android diagnostic: persistent sub-step markers for instantiate() ---
+// Writes a one-line marker to a file in the app's filesDir. Survives native
+// crashes (SIGABRT during cleanup) so the next launch can read which sub-step
+// of instantiate() / wrapper->init() was in progress when the abort fired.
+// The functions are NON-static so wrapper.h's inline init() can call them.
+// DIAGNOSTIC ONLY — remove for production.
+#ifdef __ANDROID__
+#include <fcntl.h>
+#include <unistd.h>
+#include <stdio.h>
+namespace lsp {
+namespace diag {
+void marker(const char *phase)
+{
+    int fd = ::open("/data/data/com.piano.sequencer/files/lsp_prepare_marker.log",
+                    O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0600);
+    if (fd < 0) return;
+    char buf[256];
+    int n = snprintf(buf, sizeof(buf), "slot=0 phase=%s\n", phase);
+    ::write(fd, buf, static_cast<size_t>(n));
+    ::close(fd);
+}
+void marker_rc(const char *phase, int rc)
+{
+    int fd = ::open("/data/data/com.piano.sequencer/files/lsp_prepare_marker.log",
+                    O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0600);
+    if (fd < 0) return;
+    char buf[256];
+    int n = snprintf(buf, sizeof(buf), "slot=0 phase=%s rc=%d\n", phase, rc);
+    ::write(fd, buf, static_cast<size_t>(n));
+    ::close(fd);
+}
+} // namespace diag
+} // namespace lsp
+#else
+namespace lsp {
+namespace diag {
+inline void marker(const char *) {}
+inline void marker_rc(const char *, int) {}
+} // namespace diag
+} // namespace lsp
+#endif
+
 
 #define LADSPA_LOG_FILE         "lsp-ladspa.log"
 
