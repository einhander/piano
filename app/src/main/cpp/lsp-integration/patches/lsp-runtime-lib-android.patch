 {
     namespace ipc
     {
-    #if defined(PLATFORM_LINUX) || defined(PLATFORM_FREEBSD)
+    #if (defined(PLATFORM_LINUX) || defined(PLATFORM_FREEBSD)) && !defined(__ANDROID__)
+        // Bionic does not implement robust pthread mutexes
