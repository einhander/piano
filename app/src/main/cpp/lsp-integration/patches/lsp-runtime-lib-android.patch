diff --git a/dependencies.mk b/dependencies.mk
index a79cb79..e49e8be 100644
--- a/dependencies.mk
+++ b/dependencies.mk
@@ -119,3 +119,10 @@ ALL_DEPENDENCIES = \
   $(MACOS_TEST_DEPENDENCIES) \
   $(HAIKU_TEST_DEPENDENCIES)
 
+# --- Android cross-compile: libsndfile is not available on bionic and the
+# LADSPA DSP path does not load audio files from disk, so drop it from the
+# build dependency list (and thus the -DUSE_LIBSNDFILE define / link flags).
+ifeq ($(ANDROID_TARGET),1)
+  DEPENDENCIES := $(filter-out LIBSNDFILE,$(DEPENDENCIES))
+  TEST_DEPENDENCIES := $(filter-out LIBSNDFILE,$(TEST_DEPENDENCIES))
+endif
diff --git a/include/lsp-plug.in/io/charset.h b/include/lsp-plug.in/io/charset.h
index aee5274..75a4666 100644
--- a/include/lsp-plug.in/io/charset.h
+++ b/include/lsp-plug.in/io/charset.h
@@ -30,6 +30,17 @@
 #else
     #include <iconv.h>
     #include <locale.h>
+    #if defined(__ANDROID__)
+        // Bionic ships <iconv.h> with the iconv_t typedef but does NOT declare
+        // the iconv/iconv_open/iconv_close functions. Provide declarations that
+        // resolve to a no-op shim linked in for the Android LADSPA build.
+        extern "C" {
+            iconv_t iconv_open(const char *tocode, const char *fromcode);
+            size_t  iconv(iconv_t cd, char **inbuf, size_t *inbytesleft,
+                          char **outbuf, size_t *outbytesleft);
+            int     iconv_close(iconv_t cd);
+        }
+    #endif /* __ANDROID__ */
 #endif /* PLATFORM_WINDOWS */
 
 #define LSP_UTF32_EOF       lsp_utf32_t(-1)
