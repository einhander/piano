+#if defined(__ANDROID__)
+    // On Android (Bionic) libsndfile is not available and the LADSPA DSP path
+    // never loads audio files from disk; always use the vendored stub here,
+    // even if USE_LIBSNDFILE is still set by the per-module dependency list.
+    #include <lsp-plug.in/3rdparty/sndfile_stub.h>
