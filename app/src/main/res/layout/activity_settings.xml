<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ui_background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.Piano.Toolbar"
        android:elevation="0dp"
        android:title="@string/settings_title"
        app:titleTextColor="@color/ui_surface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/settingsSections"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/card_frame"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_recording_folder"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnRecordingFolder"
                    style="@style/Widget.Piano.OutlinedControl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAllCaps="false"
                    android:textColor="@color/ui_control_text" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRecordingFolder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_recording_folder_hint"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- SoundFont Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/card_frame"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_sf2_title"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnBrowse"
                    style="@style/Widget.Piano.OutlinedControl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_browse"
                    android:textColor="@color/ui_control_text" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSf2ListHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/settings_sf2_loaded_title"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/llSf2List"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvSf2Empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/settings_sf2_none"
                    android:textSize="12sp"
                    android:textColor="?attr/colorControlNormal" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">
                <TextView
                    android:id="@+id/tvSf2Count"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/ui_muted" />

                <Button
                    android:id="@+id/btnUnload"
                    style="@style/Widget.Piano.OutlinedControl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_unload_all"
                    android:textColor="@color/ui_control_danger_text" />
                </LinearLayout>

            </LinearLayout>

            <!-- FluidSynth Settings Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/card_frame"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_fluidsynth_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Polyphony -->
                <TextView
                    android:id="@+id/tvPolyphony"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="14sp"
                    android:textColor="@color/ui_text" />

                <SeekBar
                    android:id="@+id/seekBarPolyphony"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:minHeight="48dp"
                    android:contentDescription="@string/settings_polyphony_label"
                    android:layout_marginBottom="0dp"
                    android:min="1"
                    android:max="2048"
                    android:progress="64" />

                <!-- Master Gain -->
                <TextView
                    android:id="@+id/tvMasterGain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="14sp"
                    android:textColor="@color/ui_text" />

                <SeekBar
                    android:id="@+id/seekBarMasterGain"
                    android:minHeight="48dp"
                    android:contentDescription="@string/settings_master_gain_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:max="2000"
                    android:progress="1000" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GLOBAL FluidSynth Reverb · applies to all synth instruments"
                    android:textColor="@color/ui_text"
                    android:textSize="14sp" />
                <!-- Existing formatted state label contains both name and On/Off. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvReverb"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/ui_text" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchReverb"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:contentDescription="@string/settings_reverb_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/globalReverbControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvChorus"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/ui_text" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchChorus"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:contentDescription="@string/settings_chorus_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
                </LinearLayout>

                <!-- Interpolation (Fix #12) -->
                <TextView
                    android:id="@+id/tvInterps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="14sp"
                    android:textColor="@color/ui_text" />

                <Spinner
                    android:id="@+id/spinnerInterps"
                    android:minHeight="48dp"
                    android:contentDescription="@string/settings_interps_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp" />

                <!-- Auto buffer size (m3): when ON, the Oboe LatencyTuner manages the buffer
                     size (2×burst..8×burst) and the seekbar below is disabled. -->
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAutoTune"
                    android:minHeight="48dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp"
                    android:text="@string/settings_auto_tune_label"
                    android:checked="true" />

                <!-- Buffer size (Fix #4) -->
                <TextView
                    android:id="@+id/tvBufferSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="14sp"
                    android:textColor="@color/ui_text" />

                <SeekBar
                    android:id="@+id/seekBarBufferSize"
                    android:minHeight="48dp"
                    android:contentDescription="@string/settings_buffer_size_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:min="0"
                    android:max="15"
                    android:progress="2" />

            </LinearLayout>

            <!-- MIDI Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/card_frame"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_midi_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_pitch_bend_channels_label"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/settings_pitch_bend_channels_desc"
                    android:textSize="12sp"
                    android:textColor="?attr/colorControlNormal" />

                <Button
                    android:id="@+id/btnPitchBendChannels"
                    style="@style/Widget.Piano.OutlinedControl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/ui_control_text" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
