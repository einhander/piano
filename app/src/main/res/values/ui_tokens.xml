<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ui_primary">#4B2A98</color>
    <color name="ui_active">#008578</color>
    <color name="ui_background">#F5F4F8</color>
    <color name="ui_surface">#FFFFFF</color>
    <color name="ui_text">#211D2B</color>
    <color name="ui_muted">#625C70</color>
    <color name="ui_outline">#DED9E7</color>
    <color name="ui_danger">#B32636</color>
    <color name="ui_selected">#EDE5FA</color>
    <dimen name="ui_target">48dp</dimen>
    <style name="ThemeOverlay.Piano.Toolbar" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:textColorPrimary">@color/ui_surface</item>
        <item name="colorControlNormal">@color/ui_surface</item>
    </style>
    <style name="Widget.Piano.Toolbar" parent="Widget.AppCompat.Toolbar">
        <item name="titleTextColor">@color/ui_surface</item>
        <item name="subtitleTextColor">@color/ui_surface</item>
        <item name="android:background">@color/ui_primary</item>
        <item name="android:elevation">0dp</item>
        <item name="android:theme">@style/ThemeOverlay.Piano.Toolbar</item>
    </style>
    <style name="Widget.Piano.Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ui_primary</item>
    </style>
</resources>
